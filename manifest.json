{
  "manifest_version": 3,
  "name": "Dolby Audio Equalizer & 3D Spatial Sound",
  "version": "1.0.0",
  "description": "Tingkatkan kualitas suara YouTube & video tab aktif menjadi sekelas Dolby Atmos dengan 10-Band EQ, Bass Boost, dan Spatial Surround 3D.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dolby Audio Equalizer & 3D Sound",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
